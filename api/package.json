{
  "name": "echolon-api",
  "version": "1.0.1",
  "description": "Echolon API service - handles proxy, authentication, subscriptions, and team management",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --env-file .env.production --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:pm2": "pm2 start ecosystem.config.js",
    "reload:pm2": "pm2 reload echolon-api",
    "stop:pm2": "pm2 stop echolon-api",
    "deploy": "set -a && source .env.production && set +a && ./scripts/deploy.sh",
    "ssh": "ssh -i ../secrets/mocky.pem ec2-user@3.66.151.89"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.964.0",
    "@aws-sdk/client-ses": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.964.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "sequelize": "^6.35.0",
    "stripe": "^14.0.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/passport": "^1.0.16",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
