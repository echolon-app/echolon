---
// Search Button with Command Palette
const pages = [
  { title: 'Introduction', href: '/', section: 'Getting Started' },
  { title: 'Quick Start', href: '/getting-started/quick-start', section: 'Getting Started' },
  { title: 'Installation', href: '/getting-started/installation', section: 'Getting Started' },
  { title: 'Desktop App', href: '/clients/desktop', section: 'Clients' },
  { title: 'Web App', href: '/clients/web', section: 'Clients' },
  { title: 'Workspaces', href: '/features/workspaces', section: 'Features' },
  { title: 'Collections', href: '/features/collections', section: 'Features' },
  { title: 'Environments', href: '/features/environments', section: 'Features' },
  { title: 'Variables', href: '/features/variables', section: 'Features' },
  { title: 'Scripts', href: '/features/scripts', section: 'Features' },
  { title: 'History', href: '/features/history', section: 'Features' },
  { title: 'Shortcuts', href: '/features/shortcuts', section: 'Features' },
  { title: 'REST API', href: '/protocols/rest', section: 'Protocols' },
  { title: 'GraphQL', href: '/protocols/graphql', section: 'Protocols' },
  { title: 'WebSocket', href: '/protocols/websocket', section: 'Protocols' },
  { title: 'gRPC', href: '/protocols/grpc', section: 'Protocols' },
  { title: 'OpenAPI / Swagger', href: '/import-export/openapi', section: 'Import & Export' },
  { title: 'Postman', href: '/import-export/postman', section: 'Import & Export' },
  { title: 'Insomnia', href: '/import-export/insomnia', section: 'Import & Export' },
  { title: 'Git Integration', href: '/advanced/git-integration', section: 'Advanced' },
  { title: 'Proxy Settings', href: '/advanced/proxy', section: 'Advanced' },
];
---

<button class="search-btn" type="button" aria-label="Search documentation" id="search-trigger">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <span class="search-btn__text">Search docs...</span>
  <kbd class="search-btn__shortcut">⌘K</kbd>
</button>

<!-- Search Modal -->
<div class="search-modal" id="search-modal" role="dialog" aria-modal="true" aria-label="Search documentation">
  <div class="search-modal__backdrop" id="search-backdrop"></div>
  <div class="search-modal__container">
    <div class="search-modal__header">
      <svg class="search-modal__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        class="search-modal__input" 
        id="search-input" 
        placeholder="Search documentation..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-modal__esc">Esc</kbd>
    </div>
    <div class="search-modal__results" id="search-results">
      <div class="search-modal__empty">
        Type to search...
      </div>
    </div>
    <div class="search-modal__footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
      <span><kbd>Enter</kbd> to select</span>
      <span><kbd>Esc</kbd> to close</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ pages }}>
  (function() {
    // Prevent duplicate initialization
    if (window.__searchInitialized) return;
    window.__searchInitialized = true;
    
    const trigger = document.getElementById('search-trigger');
    const modal = document.getElementById('search-modal');
    const backdrop = document.getElementById('search-backdrop');
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    
    let selectedIndex = 0;
    let filteredPages = [];
    
    function openModal() {
      modal.classList.add('is-open');
      input.focus();
      document.body.style.overflow = 'hidden';
      renderResults('');
    }
    
    function closeModal() {
      modal.classList.remove('is-open');
      input.value = '';
      document.body.style.overflow = '';
      selectedIndex = 0;
    }
    
    function filterPages(query) {
      if (!query.trim()) {
        return pages;
      }
      const q = query.toLowerCase();
      return pages.filter(function(page) {
        return page.title.toLowerCase().includes(q) || 
               page.section.toLowerCase().includes(q);
      });
    }
    
    function renderResults(query) {
      filteredPages = filterPages(query);
      selectedIndex = 0;
      
      if (filteredPages.length === 0) {
        results.innerHTML = '<div class="search-modal__empty">No results found for "' + query + '"</div>';
        return;
      }
      
      // Group by section
      var grouped = {};
      filteredPages.forEach(function(page) {
        if (!grouped[page.section]) grouped[page.section] = [];
        grouped[page.section].push(page);
      });
      
      var html = '';
      var index = 0;
      
      for (var section in grouped) {
        var sectionPages = grouped[section];
        html += '<div class="search-modal__group"><div class="search-modal__group-title">' + section + '</div>';
        for (var i = 0; i < sectionPages.length; i++) {
          var page = sectionPages[i];
          var isSelected = index === selectedIndex;
          html += '<a href="' + page.href + '" class="search-modal__result' + (isSelected ? ' is-selected' : '') + '" data-index="' + index + '">' +
            '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">' +
            '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>' +
            '<polyline points="14 2 14 8 20 8"></polyline>' +
            '</svg>' +
            '<span>' + page.title + '</span>' +
            '</a>';
          index++;
        }
        html += '</div>';
      }
      
      results.innerHTML = html;
      
      // Add click listeners
      var resultLinks = results.querySelectorAll('.search-modal__result');
      resultLinks.forEach(function(el) {
        el.addEventListener('click', function() {
          closeModal();
        });
      });
    }
    
    function updateSelection() {
      var items = results.querySelectorAll('.search-modal__result');
      items.forEach(function(item, i) {
        if (i === selectedIndex) {
          item.classList.add('is-selected');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('is-selected');
        }
      });
    }
    
    function navigateToSelected() {
      if (filteredPages[selectedIndex]) {
        window.location.href = filteredPages[selectedIndex].href;
        closeModal();
      }
    }
    
    // Event listeners
    trigger.addEventListener('click', openModal);
    backdrop.addEventListener('click', closeModal);
    
    input.addEventListener('input', function(e) {
      renderResults(e.target.value);
    });
    
    document.addEventListener('keydown', function(e) {
      // Open with Cmd/Ctrl + K
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (modal.classList.contains('is-open')) {
          closeModal();
        } else {
          openModal();
        }
        return;
      }
      
      // Only handle other keys if modal is open
      if (!modal.classList.contains('is-open')) return;
      
      if (e.key === 'Escape') {
        e.preventDefault();
        closeModal();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, filteredPages.length - 1);
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        navigateToSelected();
      }
    });
  })();
</script>

<style is:global>
  .search-btn {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    width: 100%;
    padding: var(--spacing-2) var(--spacing-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  
  .search-btn:hover {
    color: var(--color-text-secondary);
    border-color: var(--color-text-muted);
  }
  
  .search-btn__text {
    flex: 1;
    text-align: left;
  }
  
  .search-btn__shortcut {
    padding: var(--spacing-1) var(--spacing-2);
    font-size: var(--font-size-xs);
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  
  /* Modal */
  .search-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    align-items: flex-start;
    justify-content: center;
    padding: 80px 16px;
  }
  
  .search-modal.is-open {
    display: flex;
  }
  
  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }
  
  .search-modal__container {
    position: relative;
    width: 100%;
    max-width: 600px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }
  
  .search-modal__header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px;
    border-bottom: 1px solid var(--color-border);
  }
  
  .search-modal__icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
  }
  
  .search-modal__input {
    flex: 1;
    background: none;
    border: none;
    font-size: 16px;
    color: var(--color-text);
    outline: none;
  }
  
  .search-modal__input::placeholder {
    color: var(--color-text-muted);
  }
  
  .search-modal__esc {
    padding: 4px 8px;
    font-size: 12px;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
  
  .search-modal__results {
    max-height: 400px;
    overflow-y: auto;
    padding: 8px;
  }
  
  .search-modal__empty {
    padding: 32px;
    text-align: center;
    color: var(--color-text-muted);
  }
  
  .search-modal__group {
    margin-bottom: 8px;
  }
  
  .search-modal__group-title {
    padding: 8px 12px;
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .search-modal__result {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    color: var(--color-text-secondary);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
  }
  
  .search-modal__result:hover {
    background: var(--color-bg-card);
    color: var(--color-text);
  }
  
  .search-modal__result.is-selected {
    background: var(--color-primary-glow);
    color: var(--color-primary);
  }
  
  .search-modal__result svg {
    flex-shrink: 0;
    opacity: 0.5;
  }
  
  .search-modal__result span {
    flex: 1;
  }
  
  .search-modal__footer {
    display: flex;
    gap: 16px;
    padding: 12px 16px;
    border-top: 1px solid var(--color-border);
    font-size: 12px;
    color: var(--color-text-muted);
  }
  
  .search-modal__footer kbd {
    padding: 2px 6px;
    font-family: var(--font-sans);
    background: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }
</style>
