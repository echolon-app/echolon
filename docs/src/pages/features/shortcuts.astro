---
import DocsLayout from '../../layouts/DocsLayout.astro';

const headings = [
  { depth: 2, slug: 'general', text: 'General' },
  { depth: 2, slug: 'request', text: 'Request' },
  { depth: 2, slug: 'response', text: 'Response' },
];
---

<DocsLayout title="Shortcuts" headings={headings}>
  <div class="prose">
    <h1>Keyboard Shortcuts</h1>
    <p class="lead">
      Speed up your workflow with keyboard shortcuts.
    </p>
    
    <h2 id="general">General</h2>
    <table class="shortcuts-table">
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>K</kbd></td><td>Search & command menu</td></tr>
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>O</kbd></td><td>Keyboard shortcuts</td></tr>
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>E</kbd></td><td>New Tab</td></tr>
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>D</kbd></td><td>Close Tab</td></tr>
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>B</kbd></td><td>Toggle sidebar</td></tr>
      <tr><td><kbd>ESC</kbd></td><td>Close current menu</td></tr>
    </table>
    
    <h2 id="request">Request</h2>
    <table class="shortcuts-table">
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>Enter</kbd></td><td>Send Request</td></tr>
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>Z</kbd></td><td>Save Request</td></tr>
    </table>
    
    <h2 id="response">Response</h2>
    <table class="shortcuts-table">
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>J</kbd></td><td>Download response as file</td></tr>
      <tr><td><kbd>Cmd/Ctrl</kbd> + <kbd>.</kbd></td><td>Copy response to clipboard</td></tr>
    </table>
  </div>
</DocsLayout>

<style>
  .prose { color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .prose h1 { font-size: var(--font-size-4xl); color: var(--color-text); margin-bottom: var(--spacing-4); }
  .prose h2 { font-size: var(--font-size-2xl); color: var(--color-text); margin-top: var(--spacing-10); margin-bottom: var(--spacing-4); padding-top: var(--spacing-4); border-top: 1px solid var(--color-border-subtle); }
  .prose h2:first-of-type { border-top: none; padding-top: 0; }
  .prose p { margin-bottom: var(--spacing-4); }
  .prose .lead { font-size: var(--font-size-lg); margin-bottom: var(--spacing-6); }
  .shortcuts-table { width: 100%; margin: var(--spacing-4) 0; border-collapse: collapse; }
  .shortcuts-table td { padding: var(--spacing-3); border-bottom: 1px solid var(--color-border-subtle); }
  .shortcuts-table td:first-child { width: 40%; }
  kbd { padding: var(--spacing-1) var(--spacing-2); background: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: var(--font-size-xs); font-family: inherit; }
</style>

