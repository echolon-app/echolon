---
import DocsLayout from '../../layouts/DocsLayout.astro';

const headings = [
  { depth: 2, slug: 'importing', text: 'Importing from Insomnia' },
  { depth: 2, slug: 'whats-imported', text: "What's Imported" },
];
---

<DocsLayout title="Insomnia" headings={headings}>
  <div class="prose">
    <h1>Insomnia Import</h1>
    <p class="lead">
      Import your Insomnia workspaces and requests.
    </p>
    
    <h2 id="importing">Importing from Insomnia</h2>
    <p>
      Export your Insomnia workspace and import the JSON file into Echolon. Your requests and folder structure will be converted.
    </p>
    
    <h2 id="whats-imported">What's Imported</h2>
    <ul class="list">
      <li>Requests (REST, GraphQL)</li>
      <li>Request groups (folders)</li>
      <li>Environments</li>
      <li>Headers and authentication</li>
    </ul>
  </div>
</DocsLayout>

<style>
  .prose { color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .prose h1 { font-size: var(--font-size-4xl); color: var(--color-text); margin-bottom: var(--spacing-4); }
  .prose h2 { font-size: var(--font-size-2xl); color: var(--color-text); margin-top: var(--spacing-10); margin-bottom: var(--spacing-4); padding-top: var(--spacing-4); border-top: 1px solid var(--color-border-subtle); }
  .prose h2:first-of-type { border-top: none; padding-top: 0; }
  .prose p { margin-bottom: var(--spacing-4); }
  .prose .lead { font-size: var(--font-size-lg); margin-bottom: var(--spacing-6); }
  .prose .list { margin: var(--spacing-4) 0; padding-left: var(--spacing-6); }
  .prose .list li { margin-bottom: var(--spacing-2); list-style: disc; }
</style>

