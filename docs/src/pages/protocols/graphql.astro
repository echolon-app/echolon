---
import DocsLayout from '../../layouts/DocsLayout.astro';

const headings = [
  { depth: 2, slug: 'overview', text: 'Overview' },
  { depth: 2, slug: 'queries', text: 'Queries' },
  { depth: 2, slug: 'mutations', text: 'Mutations' },
  { depth: 2, slug: 'variables', text: 'Variables' },
];
---

<DocsLayout title="GraphQL" headings={headings}>
  <div class="prose">
    <h1>GraphQL</h1>
    <p class="lead">
      Build and execute GraphQL queries with syntax highlighting and schema introspection.
    </p>
    
    <h2 id="overview">Overview</h2>
    <p>
      Echolon provides a dedicated GraphQL editor with features like schema introspection, auto-complete, and query formatting.
    </p>
    
    <h2 id="queries">Queries</h2>
    <p>
      Write GraphQL queries in the dedicated editor. The schema browser helps you explore available types and fields.
    </p>
    
    <h2 id="mutations">Mutations</h2>
    <p>
      Execute mutations to modify data on your GraphQL server. Variables and headers are fully supported.
    </p>
    
    <h2 id="variables">Variables</h2>
    <p>
      Define GraphQL variables in JSON format and reference them in your queries using the <code>$variableName</code> syntax.
    </p>
  </div>
</DocsLayout>

<style>
  .prose { color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .prose h1 { font-size: var(--font-size-4xl); color: var(--color-text); margin-bottom: var(--spacing-4); }
  .prose h2 { font-size: var(--font-size-2xl); color: var(--color-text); margin-top: var(--spacing-10); margin-bottom: var(--spacing-4); padding-top: var(--spacing-4); border-top: 1px solid var(--color-border-subtle); }
  .prose h2:first-of-type { border-top: none; padding-top: 0; }
  .prose p { margin-bottom: var(--spacing-4); }
  .prose .lead { font-size: var(--font-size-lg); margin-bottom: var(--spacing-6); }
  .prose code { padding: var(--spacing-1) var(--spacing-2); font-size: var(--font-size-sm); background: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
</style>

