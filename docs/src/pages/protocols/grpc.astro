---
import DocsLayout from '../../layouts/DocsLayout.astro';

const headings = [
  { depth: 2, slug: 'overview', text: 'Overview' },
  { depth: 2, slug: 'proto-files', text: 'Proto Files' },
  { depth: 2, slug: 'making-calls', text: 'Making Calls' },
];
---

<DocsLayout title="gRPC" headings={headings}>
  <div class="prose">
    <h1>gRPC</h1>
    <p class="lead">
      Test gRPC services with proto file support.
    </p>
    
    <h2 id="overview">Overview</h2>
    <p>
      Echolon supports gRPC for testing high-performance RPC services. Import your proto files to discover available services and methods.
    </p>
    
    <h2 id="proto-files">Proto Files</h2>
    <p>
      Import <code>.proto</code> files to automatically discover services, methods, and message types. Echolon generates the appropriate request templates for each method.
    </p>
    
    <h2 id="making-calls">Making Calls</h2>
    <p>
      Select a service and method, fill in the request message, and execute. Echolon supports unary, server streaming, client streaming, and bidirectional streaming calls.
    </p>
  </div>
</DocsLayout>

<style>
  .prose { color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .prose h1 { font-size: var(--font-size-4xl); color: var(--color-text); margin-bottom: var(--spacing-4); }
  .prose h2 { font-size: var(--font-size-2xl); color: var(--color-text); margin-top: var(--spacing-10); margin-bottom: var(--spacing-4); padding-top: var(--spacing-4); border-top: 1px solid var(--color-border-subtle); }
  .prose h2:first-of-type { border-top: none; padding-top: 0; }
  .prose p { margin-bottom: var(--spacing-4); }
  .prose .lead { font-size: var(--font-size-lg); margin-bottom: var(--spacing-6); }
  .prose code { padding: var(--spacing-1) var(--spacing-2); font-size: var(--font-size-sm); background: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
</style>

