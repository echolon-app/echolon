---
import DocsLayout from '../../layouts/DocsLayout.astro';

const headings = [
  { depth: 2, slug: 'overview', text: 'Overview' },
  { depth: 2, slug: 'connecting', text: 'Connecting' },
  { depth: 2, slug: 'messages', text: 'Sending Messages' },
];
---

<DocsLayout title="WebSocket" headings={headings}>
  <div class="prose">
    <h1>WebSocket</h1>
    <p class="lead">
      Test real-time WebSocket connections and messaging.
    </p>
    
    <h2 id="overview">Overview</h2>
    <p>
      Echolon supports WebSocket connections for testing real-time APIs. Connect to any WebSocket server and send/receive messages in real-time.
    </p>
    
    <h2 id="connecting">Connecting</h2>
    <p>
      Enter a WebSocket URL (<code>ws://</code> or <code>wss://</code>) and click Connect. You can also add custom headers for authentication.
    </p>
    
    <h2 id="messages">Sending Messages</h2>
    <p>
      Once connected, send text or JSON messages and see responses in real-time. The message log shows all sent and received messages with timestamps.
    </p>
  </div>
</DocsLayout>

<style>
  .prose { color: var(--color-text-secondary); line-height: var(--line-height-relaxed); }
  .prose h1 { font-size: var(--font-size-4xl); color: var(--color-text); margin-bottom: var(--spacing-4); }
  .prose h2 { font-size: var(--font-size-2xl); color: var(--color-text); margin-top: var(--spacing-10); margin-bottom: var(--spacing-4); padding-top: var(--spacing-4); border-top: 1px solid var(--color-border-subtle); }
  .prose h2:first-of-type { border-top: none; padding-top: 0; }
  .prose p { margin-bottom: var(--spacing-4); }
  .prose .lead { font-size: var(--font-size-lg); margin-bottom: var(--spacing-6); }
  .prose code { padding: var(--spacing-1) var(--spacing-2); font-size: var(--font-size-sm); background: var(--color-bg-tertiary); border: 1px solid var(--color-border); border-radius: var(--radius-sm); }
</style>

