{
  "name": "echolon-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Echolon - A powerful, local-first API client",
  "author": "Philipp Maximilian Wesel",
  "license": "MIT",
  "workspaces": [
    "core",
    "landing",
    "proxy-server",
    "sample-api",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=core",
    "dev:landing": "npm run dev --workspace=landing",
    "dev:web": "npm run dev --workspace=web",
    "dev:proxy": "npm run dev --workspace=proxy-server",
    "build": "npm run build --workspace=core",
    "build:landing": "npm run build --workspace=landing",
    "build:web": "npm run build --workspace=web",
    "package": "npm run package --workspace=core",
    "package:mac": "npm run package:mac --workspace=core",
    "package:win": "npm run package:win --workspace=core",
    "package:linux": "npm run package:linux --workspace=core"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
