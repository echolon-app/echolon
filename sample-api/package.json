{
  "name": "sample-api",
  "version": "1.0.2",
  "description": "Sample CRUD API with OpenAPI documentation and GraphQL for testing Echolon import",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "start:pm2": "pm2 start ecosystem.config.js",
    "reload:pm2": "pm2 reload echolon-sample-api",
    "stop:pm2": "pm2 stop echolon-sample-api",
    "deploy": "set -a && source .env.production && set +a && ./deploy/deploy.sh"
  },
  "keywords": ["api", "openapi", "graphql", "crud", "sample"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "graphql": "^16.9.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.4",
    "@types/uuid": "^9.0.6",
    "@types/ws": "^8.5.13",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  }
}

